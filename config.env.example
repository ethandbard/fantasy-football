# Copy to config.env and fill in. Never commit config.env.
# Each running copy of the container is one league plus one Discord destination.

DISCORD_WEBHOOK_URL=
LEAGUE_ID=
LEAGUE_YEAR=2026
ESPN_S2=
SWID=
DISCORD_BOT_TOKEN=

START_DATE=2026-09-04
END_DATE=2027-01-05
TIMEZONE=America/New_York
DAILY_WAIVER=False
MONITOR_REPORT=True
TOP_HALF_SCORING=False
INIT_MSG=

DASHBOARD_PORT=8000
DB_PATH=/app/data/fantasy.db

# Public URL returned by the /dashboard slash command. Use http://localhost:8000
# for a local-only run. On a tunneled host, set the https hostname.
DASHBOARD_URL=http://localhost:8000
